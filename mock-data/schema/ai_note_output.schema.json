  "properties": {
    "explicit_arrival_time": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "minutes_early": {
      "type": [
        "integer",
        "null"
