# Sao chép thành .env rồi điền. Tạo khóa: python scripts/make_key.py
APP_SECRET_KEY=
# Khóa ký cookie đăng nhập (tùy chọn). Để trống = dẫn xuất từ APP_SECRET_KEY. Đổi khóa = mọi người đăng nhập lại.
SESSION_SECRET_KEY=
LLM_PROVIDER=ollama
# ollama (mặc định khi clone) | hybrid (OpenAI ưu tiên, Ollama dự phòng) | openai | mock
# hybrid/openai chỉ gọi API ngoài với dữ liệu GIẢ: SYNTHETIC_DATA_ONLY=1 và không phải production.
# hybrid thiếu key / chưa được phép / production -> chỉ Ollama. OpenAI lỗi / hết ngân sách -> Ollama.
# Chỉ điền key trong .env trên máy chủ của bạn; không đưa key lên GitHub hoặc frontend.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BUDGET_USD=1.0  # ngân sách mỗi ngày
SYNTHETIC_DATA_ONLY=
# AI chấm điểm chọn câu hỏi: inherit | rules | mock | ollama | hybrid | openai
QUESTION_SELECTOR_PROVIDER=inherit
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
TEAMS_WEBHOOK_URL=
SMS_WHITELIST=0900000001,0900000002
APP_USERS_FILE=config/users.yaml
# Địa chỉ app để tạo đường dẫn form trong SMS
APP_BASE_URL=http://localhost:8000
# Kênh test_api: để trống = mô phỏng, không gọi mạng
SMS_TEST_API_URL=
# Dùng thật: APP_ENV=production (tắt form demo + API docs; chặn khởi động nếu còn mật khẩu demo / chưa HTTPS)
APP_ENV=
# 1 = cookie chỉ gửi qua HTTPS (bắt buộc khi APP_ENV=production)
APP_COOKIE_SECURE=
# 0 = tắt việc định kỳ nền (gom vàng theo giờ, gửi lại đỏ, xóa file quá hạn) – chỉ để test
APP_JOBS=1
